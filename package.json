{
  "name": "pergamum",
  "productName": "Pergamum",
  "version": "0.1.0",
  "private": true,
  "author": "Pergamum Contributors",
  "description": "An open-source IDE for novelists.",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "electron-forge start",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.renderer.json",
    "test": "vitest run",
    "build": "npm run typecheck && electron-forge package",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.4",
    "codemirror": "^6.0.2",
    "electron-squirrel-startup": "^1.0.1",
    "markdown-it": "^14.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/markdown-it": "^14.1.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.11",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "39.8.10",
    "typescript": "^5.9.2",
    "vite": "^6.3.5",
    "vitest": "^4.1.10"
  }
}
